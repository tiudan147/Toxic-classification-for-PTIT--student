{
   "action": {
      "default_icon": {
         "128": "assets/logo.png",
         "16": "assets/logo.png",
         "48": "assets/logo.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [
            "lib/scraper-core.js",
            "content.js"
         ],
         "matches": [
            "*://facebook.com/*",
            "*://*.facebook.com/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
   },
   "default_locale": "en",
   "description": "__MSG_extDescription__",
   "externally_connectable": {
      "matches": [
         "https://auth.fbgroupbulkposter.com/*",
         "http://localhost:3000/*",
         "http://localhost:5000/*"
      ]
   },
   "host_permissions": [
      "https://*/*",
      "http://*/*"
   ],
   "icons": {
      "128": "assets/logo.png",
      "16": "assets/logo.png",
      "48": "assets/logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "oauth2": {
      "client_id": "315865406417-ubtfoajkpdt3a9odshck2kttb33jf6mk.apps.googleusercontent.com",
      "scopes": [
         "email",
         "profile",
         "openid"
      ]
   },
   "permissions": [
      "storage",
      "cookies",
      "system.display",
      "tabs",
      "scripting"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.24.1",
   "version_name": "1.24.1 fix nut comment (data-ad-rendering-role)",
   "web_accessible_resources": [
      {
         "matches": [
            "https://*/*",
            "http://*/*"
         ],
         "resources": [
            "domselector.config.json"
         ]
      }
   ],
   "options_page": "scraper.html",
   "options_ui": {
      "page": "scraper.html",
      "open_in_tab": true
   }
}